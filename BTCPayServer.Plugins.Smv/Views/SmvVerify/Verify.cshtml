@model BTCPayServer.Plugins.Smv.Controllers.VerifyVm

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Bitcoin Digital Objects";

    // Navigation context only: the origin Store carried from a Store-scoped page
    // (query on GET, form field on the sha256 POST). Verify itself is public and
    // never uses this to authorize or fetch anything — it only keeps the shared
    // nav Store-aware across the verify sub-requests.
    var navStoreId = Context.GetStoreDataOrNull()?.Id;
    if (string.IsNullOrEmpty(navStoreId))
        navStoreId = Context.Request.Query["storeId"].ToString();
    if (string.IsNullOrEmpty(navStoreId) && Context.Request.HasFormContentType)
        navStoreId = Context.Request.Form["storeId"].ToString();
    if (string.IsNullOrEmpty(navStoreId))
        navStoreId = null;
}

<div class="mb-3">
    <h2 class="mb-1">Bitcoin Digital Objects</h2>
    <div class="text-muted small">
        powered by Supermultiverse
    </div>
</div>

<partial name="_SmvPluginNav" />

<p class="text-secondary">
    Verify Bitcoin Digital Objects (BDOs) issued through Supermultiverse against Bitcoin mainnet.
    Paste a <strong>BDO ID</strong> — either a UUID or a 64-character hex ID.
</p>

<form method="get" action="/plugins/smv/verify/lookup" class="mb-4">
    @if (navStoreId is not null)
    {
        @* Preserve the origin Store so the shared nav stays Store-scoped on results. *@
        <input type="hidden" name="storeId" value="@navStoreId" />
    }
    <div class="input-group">
        <input type="text"
               name="id"
               value="@Model.Query"
               class="form-control"
               placeholder="BDO ID (UUID or 64-hex)"
               autocomplete="off"
               required />
        <button type="submit" class="btn btn-primary">Verify</button>
    </div>
    <small class="form-text text-muted">
        Accepts a BDO ID in either format — a UUID or a 64-character hex ID.
    </small>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    var cls = Model.IsBlockingProofWarning ? "alert-danger" : "alert-warning";
    <div class="alert @cls">
        @Model.Error
        @if (Model.RetryAfter is int r)
        {
            <span> (retry in @r s)</span>
        }
    </div>
}

@if (Model.Collectible is { } c)
{
    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(c.ImageUrl))
            {
                <img src="@c.ImageUrl" alt="@c.Name" class="img-fluid rounded mb-3" />
            }
        </div>

        <div class="col-md-8">
            <h3>@c.Name</h3>

            @if (c.Collection is not null)
            {
                <p class="text-secondary mb-2">
                    Collection:
                    <strong>@c.Collection.Name</strong>
                    <span class="text-muted">(@c.Collection.Slug)</span>
                </p>
            }

            @if (!string.IsNullOrEmpty(c.Description))
            {
                <p>@c.Description</p>
            }

            @if (c.Attributes is { Count: > 0 })
            {
                <h5 class="mt-3">Attributes</h5>
                <table class="table table-sm">
                    <tbody>
                    @foreach (var a in c.Attributes)
                    {
                        <tr>
                            <th style="width: 30%">@a.TraitType</th>
                            <td>@a.Value</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (c.Signature is { } sig)
    {
        <h4 class="mt-4">Signature</h4>

        <dl class="row small">
            <dt class="col-sm-3">Scheme</dt>
            <dd class="col-sm-9"><code>@sig.Scheme</code></dd>

            <dt class="col-sm-3">Signer pubkey</dt>
            <dd class="col-sm-9"><code class="text-break">@sig.SignerPubkey</code></dd>

            <dt class="col-sm-3">Signature</dt>
            <dd class="col-sm-9"><code class="text-break">@sig.Signature</code></dd>

            <dt class="col-sm-3">Metadata hash</dt>
            <dd class="col-sm-9"><code class="text-break">@sig.MetadataHash</code></dd>
        </dl>
    }

    @if (c.Verification is { } v)
    {
        <h4 class="mt-4">
            Bitcoin anchor

            @if (string.Equals(v.Network, "mainnet", StringComparison.OrdinalIgnoreCase))
            {
                <span class="badge bg-success ms-2">network: mainnet</span>
            }
            else
            {
                <span class="badge bg-warning ms-2">network: @v.Network</span>
            }
        </h4>

        <dl class="row small">
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@v.Status</dd>

            <dt class="col-sm-3">tapd asset id</dt>
            <dd class="col-sm-9"><code class="text-break">@v.TapdAssetId</code></dd>

            <dt class="col-sm-3">Anchor outpoint</dt>
            <dd class="col-sm-9">
                <code class="text-break">@v.AnchorOutpoint</code>
                @if (!string.IsNullOrEmpty(v.AnchorOutpoint))
                {
                    var txid = v.AnchorOutpoint.Split(':')[0];
                    <a href="https://mempool.space/tx/@txid"
                       target="_blank"
                       rel="noopener"
                       class="ms-2">
                        mempool.space
                    </a>
                }
            </dd>

            <dt class="col-sm-3">Proof hash</dt>
            <dd class="col-sm-9"><code class="text-break">@v.ProofHash</code></dd>

            <dt class="col-sm-3">Proof size</dt>
            <dd class="col-sm-9">@v.ProofSizeBytes bytes</dd>

            <dt class="col-sm-3">Proof format</dt>
            <dd class="col-sm-9"><code>@v.ProofFormat</code></dd>
        </dl>

        <div class="d-flex gap-2 mt-3">
    <a class="btn btn-outline-primary"
       href="/plugins/smv/proof/@c.Id">
        Download .proof
    </a>

    <form method="post"
          action="/plugins/smv/verify/sha256"
          class="d-inline">
        <input type="hidden" name="id" value="@c.Id" />
        @if (navStoreId is not null)
        {
            <input type="hidden" name="storeId" value="@navStoreId" />
        }
        <button type="submit" class="btn btn-outline-success">
            Verify SHA-256
        </button>
    </form>

    <partial name="_ProofInspector" model="@c.Id" />
</div>
        @if (Model.Sha256Result is not null)
        {
            var r = Model.Sha256Result;
            <div class="mt-3 alert @(r.Match ? "alert-success" : "alert-danger")">
                <strong>@(r.Match ? "SHA-256 match. Proof integrity verified." : "SHA-256 mismatch. Do not trust this proof.")</strong>

                <dl class="row small mb-0 mt-2">
                    <dt class="col-sm-3">Computed</dt>
                    <dd class="col-sm-9"><code class="text-break">@r.Computed</code></dd>

                    <dt class="col-sm-3">Declared</dt>
                    <dd class="col-sm-9"><code class="text-break">@r.Declared</code></dd>

                    <dt class="col-sm-3">Size</dt>
                    <dd class="col-sm-9">@r.Size bytes</dd>
                </dl>
            </div>
        }
    }

    @* Image permanence: the image is pinned to IPFS (content-addressed), so it stays
       reachable independently of any single server. The CID *is* the content — it can
       only resolve to this exact image. Shown when the API publishes IPFS data. *@
    @if (!string.IsNullOrEmpty(c.ImageIpfsCid) || !string.IsNullOrEmpty(c.ImageIpfsUrl) || !string.IsNullOrEmpty(c.ImageSha256))
    {
        <h4 class="mt-4">Image permanence (IPFS)</h4>

        <p class="text-secondary small mb-2">
            The image is pinned to <strong>IPFS</strong>, a content-addressed network, so it
            stays reachable independently of any single server. The CID is derived from the
            image itself — it can only resolve to this exact file.
        </p>

        <dl class="row small">
            @if (!string.IsNullOrEmpty(c.ImageIpfsCid))
            {
                <dt class="col-sm-3">IPFS CID</dt>
                <dd class="col-sm-9"><code class="text-break">@c.ImageIpfsCid</code></dd>
            }

            @if (!string.IsNullOrEmpty(c.ImageIpfsUrl))
            {
                <dt class="col-sm-3">IPFS image</dt>
                <dd class="col-sm-9">
                    <a href="@c.ImageIpfsUrl" target="_blank" rel="noopener" class="text-break">
                        @c.ImageIpfsUrl
                    </a>
                </dd>
            }

            @if (!string.IsNullOrEmpty(c.ImageSha256))
            {
                <dt class="col-sm-3">Image SHA-256</dt>
                <dd class="col-sm-9"><code class="text-break">@c.ImageSha256</code></dd>
            }
        </dl>
    }
}