@*
    A5.0 Proof Inspector partial. Drop this <partial> next to the existing
    "Download .proof" and "Verify SHA-256" actions on the asset verify view:

        <partial name="_ProofInspector" model="@Model.AssetId" />

    Model is the asset id (string).
*@
@model string

<div class="smv-actions" style="margin-top: .5rem;">
    <button type="button"
            class="btn btn-outline-primary btn-sm"
            data-smv-inspect-proof
            data-asset-id="@Model"
            data-endpoint="@Url.Action("InspectProof", "SmvProofInspector", new { id = Model })">
        <span class="smv-inspect-label">Inspect Proof</span>
        <span class="smv-inspect-spinner d-none" aria-hidden="true">…</span>
    </button>
</div>

<section class="smv-inspector-panel mt-2 d-none"
         data-smv-inspector-panel
         data-asset-id="@Model"
         aria-live="polite">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Bitcoin Digital Object Proof Details</strong>
            <span class="badge bg-secondary" data-smv-status>Idle</span>
        </div>
        <div class="card-body">
            <div class="smv-inspector-loading d-none">
                <em>Decoding proof…</em>
            </div>

            <div class="smv-inspector-error alert alert-danger d-none" role="alert">
                <strong>Proof decode failed.</strong>
                <span data-smv-error-message></span>
                <div class="mt-2">
                    <button type="button" class="btn btn-sm btn-outline-danger" data-smv-retry>Retry</button>
                </div>
            </div>

            <div class="smv-inspector-not-configured alert alert-warning d-none" role="alert">
                STAS Proof Decode Endpoint is not configured. Set it in
                <a asp-action="Index" asp-controller="SmvSettings">plugin Settings</a>.
            </div>

            <dl class="row smv-inspector-fields d-none mb-0" data-smv-fields></dl>

            <details class="mt-3 smv-inspector-raw d-none">
                <summary>View raw JSON</summary>
                <pre class="mt-2" style="max-height: 320px; overflow:auto;"><code data-smv-raw></code></pre>
            </details>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-smv-redecode disabled>Re-decode</button>
        </div>
    </div>
</section>

<script src="/plugins/smv/proof-inspector.js"></script>