@{
    var reviewId = ViewData["ReviewId"] as string ?? "asset-review";
}

<tr class="collapse" id="@reviewId" data-review-panel>
    <td colspan="5">
        <div class="card card-body border-warning mt-2">
            <h5 class="mb-3">Review Transaction</h5>

            <dl class="row mb-3">
                <dt class="col-sm-3">Bitcoin Digital Object</dt>
                <dd class="col-sm-9">
                    <strong data-review-asset-name>-</strong>
                </dd>

                <dt class="col-sm-3">Recipient</dt>
                <dd class="col-sm-9">
                    <code class="text-break" data-review-recipient>-</code>
                    <input type="hidden" data-review-asset-id />
                    <input type="hidden" data-review-amount />
                </dd>

                <dt class="col-sm-3">Amount</dt>
                <dd class="col-sm-9" data-review-amount>-</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9" data-review-type>-</dd>
            </dl>

            <div class="alert alert-warning mb-3">
                Please review carefully. Bitcoin Digital Object transfers cannot be undone.
            </div>

            <div class="alert alert-info d-none mb-3" data-send-status>
                <strong data-send-status-title>Preparing transfer...</strong>
                <div class="small mt-1" data-send-status-message></div>
            </div>

            @* Hosted only: the LN fee invoice the merchant pays to reserve the send.
               Stays hidden for BYON (the send response carries no payment block). *@
            <div class="alert alert-warning d-none mb-3" data-send-invoice>
                <strong>Pay the Lightning fee to reserve this transfer</strong>
                <div class="small mt-1">
                    Pay this Lightning invoice with your wallet. The transfer proceeds
                    automatically once the payment settles.
                </div>
                <div class="mt-2">
                    <span class="badge bg-secondary" data-send-invoice-amount></span>
                    <span class="badge bg-secondary d-none ms-1" data-send-invoice-expiry></span>
                </div>
                <div class="text-center my-2">
                    <img data-send-invoice-qr alt="Lightning invoice QR"
                         class="bg-white p-2 rounded d-none"
                         style="max-width: 220px; width: 100%; height: auto; image-rendering: pixelated;" />
                </div>
                <code class="d-block text-break small mt-2 p-2 bg-body-tertiary rounded" data-send-invoice-value></code>
                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-send-invoice-copy>
                    Copy invoice
                </button>
            </div>

            <div class="alert alert-success d-none mb-3" data-send-success>
                <strong data-send-success-title>Transfer submitted.</strong>
                <div class="small mt-1" data-send-success-message></div>
                <code class="d-block text-break small mt-2" data-send-success-txid></code>
                <div class="progress mt-3" style="height: 1.25rem;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: 0%;"
                         aria-valuemin="0"
                         aria-valuemax="100"
                         aria-valuenow="0"
                         data-send-confirmation-progress></div>
                </div>
            </div>

            <div class="alert alert-danger d-none mb-3" data-send-error>
                <strong>Transfer failed.</strong>
                <div class="small mt-1" data-send-error-message></div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button"
                        class="btn btn-secondary btn-sm"
                        data-review-cancel>
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        data-confirm-send>
                    Confirm Send
                </button>
            </div>
        </div>
    </td>
</tr>
